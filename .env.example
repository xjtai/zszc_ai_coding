# 复制成 .env 再填真实值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交；这份示例文件只放占位符，不要填真 Key

# 模型 API Key（按你们选的模型/网关改名）
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=

# 服务端口（参考 UI 截图用的是 5001）
PORT=5001

# 故障注入开关：置为 true 可让工具调用必定失败，用于演示高可用降级（eval.md §3）
FORCE_TOOL_FAILURE=false
